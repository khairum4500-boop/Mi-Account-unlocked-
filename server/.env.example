# MI Unlock License Server & Telegram Bot Configuration

# Server Port
PORT=3000

# SQLite Database File Location
DATABASE_FILE=./mi_unlock.db

# Telegram Bot Token (from @BotFather)
# CRITICAL: Keep this server-side only. NEVER commit to public repository or APK!
TELEGRAM_BOT_TOKEN=YOUR_NEW_TOKEN

# Comma-separated list of Telegram User IDs allowed to access the admin panel
# To find your ID, message @userinfobot or @raw_data_bot on Telegram
ADMIN_TELEGRAM_IDS=YOUR_ADMIN_TELEGRAM_ID

# Secret key required for direct Admin REST API calls (x-admin-key header)
ADMIN_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Administrator Contact Defaults
DEFAULT_ADMIN_TELEGRAM=@itz_khairum
DEFAULT_ADMIN_CONTACT=01577430152
